{
  "entities": {
    "Snippet": {
      "title": "Snippet",
      "description": "Code snippet document containing source code, metadata, tags, and ownership details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the snippet." },
        "title": { "type": "string", "maxLength": 100, "description": "Title of the snippet." },
        "code": { "type": "string", "maxLength": 200000, "description": "Source code text." },
        "language": { "type": "string", "maxLength": 50, "description": "Programming language identifier." },
        "isPublic": { "type": "boolean", "description": "Whether the snippet is publicly viewable." },
        "tags": { "type": "array", "description": "List of categorization tags." },
        "ownerId": { "type": "string", "maxLength": 128, "description": "UID of snippet author." },
        "ownerName": { "type": "string", "maxLength": 100, "description": "Display name of snippet author." },
        "ownerPhoto": { "type": "string", "maxLength": 500, "description": "Avatar photo URL of author." },
        "ownerEmail": { "type": "string", "maxLength": 150, "description": "Email address of author." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." },
        "lastEditedBy": { "type": "string", "maxLength": 100, "description": "Name of the last user who edited." }
      },
      "required": ["title", "code", "language", "isPublic", "ownerId", "ownerName", "tags", "createdAt", "updatedAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Ephemeral presence document recording online status and cursor position in a snippet.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "description": "UID of the active collaborator." },
        "userName": { "type": "string", "maxLength": 100, "description": "Display name of the collaborator." },
        "userPhoto": { "type": "string", "maxLength": 500, "description": "Avatar image URL." },
        "cursorLine": { "type": "number", "description": "Current editor line position." },
        "cursorColumn": { "type": "number", "description": "Current editor column position." },
        "color": { "type": "string", "maxLength": 30, "description": "Unique accent color assigned to user cursor." },
        "lastActive": { "type": "string", "format": "date-time", "description": "Server timestamp of heartbeat." }
      },
      "required": ["userId", "userName", "cursorLine", "cursorColumn", "color", "lastActive"]
    }
  },
  "firestore": {
    "/snippets/{snippetId}": {
      "schema": "Snippet",
      "description": "Collection of shared and private code snippets."
    },
    "/snippets/{snippetId}/presence/{userId}": {
      "schema": "Presence",
      "description": "Subcollection tracking live presence and editor cursors per snippet."
    }
  }
}
